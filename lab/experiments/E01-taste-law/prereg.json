 "criteria": [
  {
   "id": "P1",
   "kind": "threshold",
   "says": "Drive. Sweet at level 3 with no bitter makes MN9 fire 32 times or more in steps 2000 to 9999, which is 20 Hz per neuron, in at least 9 of 10 seeds.",
   "measure": "mn9",
   "condition": "s3b0",
   "op": ">=",
   "value": 32,
   "overSeeds": {
    "atLeast": 9,
    "of": 10
   }
  },
  {
   "id": "P2",
   "kind": "ratio_vs_control",
   "says": "Specificity. That count is at least ten times the count when a random population of sensory neurons, the size of the sweet one, is driven in its place. Ten such populations; one that does nothing passes.",
   "measure": "mn9",
   "condition": "s3b0",
   "control": "randpop",
   "minRatio": 10
  },
  {
   "id": "P3a",
   "kind": "paired_drop",
   "says": "Brake. On the same seed, adding bitter 3 to sweet 3 cuts the MN9 count by 70% or more, in at least 9 of 10 seeds.",
   "measure": "mn9",
   "conditionA": "s3b0",
   "conditionB": "s3b3",
   "minDrop": 0.7,
   "overSeeds": {
    "atLeast": 9,
    "of": 10
   }
  },
  {
   "id": "P3b",
   "kind": "monotone",
   "says": "Brake. Along bitter 0 to 4 at sweet 3, the mean MN9 count never rises by more than 10% of its value at bitter 0.",
   "measure": "mn9",
   "conditions": [
    "s3b0",
    "s3b1",
    "s3b2",
    "s3b3",
    "s3b4"
   ],
   "direction": "nonincreasing",
   "tolerance": 0.1
  },
  {
   "id": "P4",
   "kind": "control_fraction",
   "says": "Wiring. With every neuron keeping its outputs but who receives them shuffled, at most 5% of shuffled brains reach half the real MN9 count at sweet 3.",
   "measure": "mn9",
   "condition": "s3b0",
   "control": "shuffle",
   "fraction": 0.5,
   "atMostFraction": 0.05
  },
  {
   "id": "P5",
   "kind": "fraction_active",
   "at": "shipped",
   "says": "Regime. In no trial of any condition do 20% or more of all neurons fire: the model is not in runaway.",
   "maxFraction": 0.2
  },
  {
   "id": "P7",
   "kind": "decoder_accuracy",
   "at": "shipped",
   "says": "Decoder. With thresholds set by rule from the confirmation seeds, at least 9 of 10 held-out trials at sweet 3 decode 'extend', and at least 9 of 10 at sweet 3 with bitter 3 decode 'refuse'.",
   "measure": "mn9",
   "checks": [
    {
     "condition": "s3b0",
     "expect": "extend",
     "atLeast": 9
    },
    {
     "condition": "s3b3",
     "expect": "refuse",
     "atLeast": 9
    }
   ]
  }
 ],
